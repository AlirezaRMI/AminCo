@model IReadOnlyList<Application.DTOs.Users.UserDto>
@{
    ViewData["Title"] = "کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex justify-content-between mb-3">
    <h2>کاربران</h2>
</div>
<table class="table table-dark table-bordered">
    <thead>
    <tr><th>نام</th><th>ایمیل</th><th>تلفن</th><th>فعال</th><th>عملیات</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.PhoneNumber</td>
            <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">جزئیات</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">ویرایش</a>
                <a asp-action="ManageRoles" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">نقش‌ها</a>
                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Id" data-name="@item.FullName">حذف</button>
            </td>
        </tr>
    }
    </tbody>
</table>
@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteName').innerText = name;
        });
    </script>
}