<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت</title>
    <link rel="stylesheet" href="~/admin-lte/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/admin-lte/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    @await RenderSectionAsync("Styles", false)
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                    <a class="nav-link" href="#" onclick="document.getElementById('logoutForm').submit();">خروج</a>
                </form>
            </li>
        </ul>
    </nav>

    <!-- Sidebar -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="#" class="brand-link">
            <span class="brand-text font-weight-light">پنل مدیریت</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"><i class="nav-icon fas fa-tachometer-alt"></i> <p>داشبورد</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Sections", new { area = "Admin" })"><i class="nav-icon fas fa-layer-group"></i> <p>بخش‌ها</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Categories", new { area = "Admin" })"><i class="nav-icon fas fa-tags"></i> <p>دسته‌بندی</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Products", new { area = "Admin" })"><i class="nav-icon fas fa-box"></i> <p>محصولات</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Orders", new { area = "Admin" })"><i class="nav-icon fas fa-shopping-cart"></i> <p>سفارشات</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Users", new { area = "Admin" })"><i class="nav-icon fas fa-users"></i> <p>کاربران</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Roles", new { area = "Admin" })"><i class="nav-icon fas fa-user-tag"></i> <p>نقش‌ها</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "DiscountCodes", new { area = "Admin" })"><i class="nav-icon fas fa-ticket-alt"></i> <p>کد تخفیف</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Articles", new { area = "Admin" })"><i class="nav-icon fas fa-newspaper"></i> <p>مقالات</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Portfolios", new { area = "Admin" })"><i class="nav-icon fas fa-images"></i> <p>پروژه‌ها</p></a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Reports", new { area = "Admin" })"><i class="nav-icon fas fa-chart-line"></i> <p>گزارشات</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <section class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>
            </div>
        </section>
        <section class="content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </section>
    </div>
    <footer class="main-footer">© @DateTime.Now.Year - پنل مدیریت</footer>
</div>
<script src="~/admin-lte/plugins/jquery/jquery.min.js"></script>
<script src="~/admin-lte/js/adminlte.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>