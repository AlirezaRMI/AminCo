@{
    var userEmail = User.Identity?.Name ?? "مدیر";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | پنل مدیریت</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* استایل‌های قبلی - در صورت نیاز از جواب‌های قبلی کپی کن */
        :root { --bg-dark: #0a0c0f; --surface-dark: #14171c; --border-dark: #2a2e35; --gold: #f5c542; }
        body { background: var(--bg-dark); font-family: 'Vazirmatn', Tahoma, sans-serif; }
        .admin-sidebar { position: fixed; top: 0; right: 0; bottom: 0; width: 280px; background: linear-gradient(180deg,#0f1117,#0a0c10); border-left: 1px solid var(--border-dark); z-index: 1030; overflow-y: auto; }
        .sidebar-logo { padding: 1.5rem 1rem; text-align: center; border-bottom: 1px solid var(--border-dark); }
        .sidebar-logo img { max-height: 50px; }
        .sidebar-logo h4 { color: var(--gold); margin-top: 0.75rem; }
        .nav-link-custom { display: flex; align-items: center; gap: 12px; padding: 12px 20px; margin: 4px 12px; border-radius: 12px; color: #e5e7eb; transition: 0.2s; }
        .nav-link-custom i { width: 24px; color: #9ca3af; }
        .nav-link-custom:hover { background: rgba(245,197,66,0.15); color: var(--gold); }
        .nav-link-custom.active { background: rgba(245,197,66,0.2); color: var(--gold); border-right: 3px solid var(--gold); }
        .nav-divider { font-size: 0.7rem; color: #6b7280; padding: 12px 24px 4px; }
        .admin-main { margin-right: 280px; min-height: 100vh; background: var(--bg-dark); }
        .admin-topbar { background: rgba(10,12,15,0.8); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border-dark); padding: 0.8rem 1.5rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1020; }
        .page-title { font-size: 1.3rem; font-weight: 600; color: #f3f4f6; }
        .logout-btn { background: rgba(245,197,66,0.15); border: 1px solid var(--gold); color: var(--gold); border-radius: 48px; padding: 6px 16px; text-decoration: none; }
        .content-wrapper { padding: 1.8rem; }
        @@media (max-width: 768px) { .admin-sidebar { right: -280px; } .admin-sidebar.show { right: 0; } .admin-main { margin-right: 0; } .toggle-sidebar { display: block; } }
        .toggle-sidebar { display: none; background: transparent; border: none; color: var(--gold); font-size: 1.5rem; margin-left: 15px; }
        .overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1025; }
        .overlay.show { display: block; }
    </style>
</head>
<body>
    <div class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-logo">
            <img src="~/public/img/header/AMINCO.png" alt="AminCo">
            <h4>پنل مدیریت</h4>
        </div>
        <div class="nav flex-column">
            <div class="nav-divider">داشبورد</div>
            <a class="nav-link-custom" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i> داشبورد</a>
            <div class="nav-divider">مدیریت محتوا</div>
            <a class="nav-link-custom" href="/Admin/AboutUs"><i class="fas fa-info-circle"></i> درباره ما</a>
            <a class="nav-link-custom" href="/Admin/Articles"><i class="fas fa-newspaper"></i> مقالات</a>
            <a class="nav-link-custom" href="/Admin/Portfolios"><i class="fas fa-images"></i> نمونه کارها</a>
            <a class="nav-link-custom" href="/Admin/ContactInfo"><i class="fas fa-address-card"></i> اطلاعات تماس</a>
            <div class="nav-divider">فروشگاه</div>
            <a class="nav-link-custom" href="/Admin/Categories"><i class="fas fa-tags"></i> دسته‌بندی‌ها</a>
            <a class="nav-link-custom" href="/Admin/Products"><i class="fas fa-box"></i> محصولات</a>
            <div class="nav-divider">کاربران</div>
            <a class="nav-link-custom" href="/Admin/Users"><i class="fas fa-users"></i> کاربران</a>
            <hr class="my-3 mx-3" style="border-color:#2a2e35">
            <a class="nav-link-custom text-danger" href="/Admin/Authorize/Logout"><i class="fas fa-sign-out-alt"></i> خروج</a>
        </div>
    </div>
    <div class="overlay" id="sidebarOverlay"></div>
    <div class="admin-main">
        <div class="admin-topbar">
            <div><button class="toggle-sidebar" id="toggleSidebarBtn"><i class="fas fa-bars"></i></button>
            <span class="page-title">@ViewData["Title"]</span></div>
            <div><span><i class="fas fa-user-circle"></i> @userEmail</span>
            <a href="/Admin/Authorize/Logout" class="logout-btn ms-2">خروج</a></div>
        </div>
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleBtn = document.getElementById('toggleSidebarBtn');
        if(toggleBtn) toggleBtn.onclick = () => { sidebar.classList.toggle('show'); overlay.classList.toggle('show'); };
        overlay.onclick = () => { sidebar.classList.remove('show'); overlay.classList.remove('show'); };
        document.querySelectorAll('.nav-link-custom').forEach(link => { if(link.href === window.location.href) link.classList.add('active'); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>