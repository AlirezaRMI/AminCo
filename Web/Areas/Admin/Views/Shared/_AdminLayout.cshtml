@{
    var userEmail = User.Identity?.Name ?? "مدیر";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>@ViewData["Title"] | پنل مدیریت امین کو</title>
    <!-- Bootstrap 5 RTL + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Custom admin style -->
    <link rel="stylesheet" href="~/admin-lte/admin-stayle.css">

</head>
<body>

<!-- سایدبار -->
<div class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-logo">
        <img src="~/public/img/header/AMINCO.png" alt="AminCo">
        <h4>پنل مدیریت</h4>
    </div>
    <div class="nav flex-column">
        <div class="nav-divider">داشبورد</div>
        <a class="nav-link-custom" href="/Admin/Dashboard">
            <i class="fas fa-tachometer-alt"></i> <span>داشبورد</span>
        </a>

        <div class="nav-divider">مدیریت محتوا</div>
        <a class="nav-link-custom" href="/Admin/AboutUs"><i class="fas fa-info-circle"></i> درباره ما</a>
        <a class="nav-link-custom" href="/Admin/Articles"><i class="fas fa-newspaper"></i> مقالات</a>
        <a class="nav-link-custom" href="/Admin/Portfolios"><i class="fas fa-images"></i> نمونه کارها</a>
        <a class="nav-link-custom" href="/Admin/PortfolioImages"><i class="fas fa-image"></i> تصاویر پروژه</a>
        <a class="nav-link-custom" href="/Admin/CustomDesignRequests"><i class="fas fa-pen-ruler"></i> درخواست‌های سفارشی</a>
        <a class="nav-link-custom" href="/Admin/ContactInfo"><i class="fas fa-address-card"></i> اطلاعات تماس</a>

        <div class="nav-divider">فروشگاه</div>
        <a class="nav-link-custom" href="/Admin/Sections"><i class="fas fa-layer-group"></i> بخش‌ها</a>
        <a class="nav-link-custom" href="/Admin/Categories"><i class="fas fa-tags"></i> دسته‌بندی‌ها</a>
        <a class="nav-link-custom" href="/Admin/Products"><i class="fas fa-box"></i> محصولات</a>
        <a class="nav-link-custom" href="/Admin/SpecialSales"><i class="fas fa-percent"></i> فروش ویژه</a>
        <a class="nav-link-custom" href="/Admin/DiscountCodes"><i class="fas fa-ticket-alt"></i> کدهای تخفیف</a>
        <a class="nav-link-custom" href="/Admin/Orders"><i class="fas fa-shopping-cart"></i> سفارشات</a>
        <a class="nav-link-custom" href="/Admin/Invoices"><i class="fas fa-file-invoice-dollar"></i> فاکتورها</a>

        <div class="nav-divider">کاربران & دسترسی</div>
        <a class="nav-link-custom" href="/Admin/Users"><i class="fas fa-users"></i> کاربران</a>
        <a class="nav-link-custom" href="/Admin/Roles"><i class="fas fa-user-lock"></i> نقش‌ها</a>
        <a class="nav-link-custom" href="/Admin/AdminTickets"><i class="fas fa-headset"></i> تیکت‌ها</a>

        <div class="nav-divider">گزارشات</div>
        <a class="nav-link-custom" href="/Admin/Reports"><i class="fas fa-chart-line"></i> گزارشات</a>

        <hr class="my-3 mx-3" style="border-color: #2a2e35;">
        <a class="nav-link-custom text-danger" href="/Admin/Auth/Logout">
            <i class="fas fa-sign-out-alt"></i> <span>خروج از پنل</span>
        </a>
    </div>
</div>

<div class="overlay" id="sidebarOverlay"></div>

<div class="admin-main">
    <div class="admin-topbar">
        <div class="d-flex align-items-center">
            <button class="toggle-sidebar" id="toggleSidebarBtn"><i class="fas fa-bars"></i></button>
            <div class="page-title">@ViewData["Title"]</div>
        </div>
        <div class="user-info">
            <span><i class="fas fa-user-circle"></i> @userEmail</span>
            <a href="/Admin/Auth/Logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> خروج</a>
        </div>
    </div>
    <div class="content-wrapper">
        @RenderBody()
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>

    const sidebar = document.getElementById('adminSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const toggleBtn = document.getElementById('toggleSidebarBtn');

    function closeSidebar() {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
    }
    function openSidebar() {
        sidebar.classList.add('show');
        overlay.classList.add('show');
    }

    if (toggleBtn) {
        toggleBtn.addEventListener('click', function(e) {
            if (sidebar.classList.contains('show')) closeSidebar();
            else openSidebar();
        });
    }
    overlay.addEventListener('click', closeSidebar);
    
    document.querySelectorAll('.nav-link-custom').forEach(link => {
        if (link.href === window.location.href) {
            link.classList.add('active');
        }
    });

    
    if (window.innerWidth < 768) {
        document.querySelectorAll('.nav-link-custom').forEach(link => {
            link.addEventListener('click', closeSidebar);
        });
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>