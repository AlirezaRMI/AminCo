@model IReadOnlyList<Application.DTOs.Sections.SectionDto>
@{
    ViewData["Title"] = "مدیریت بخش‌ها";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">لیست بخش‌ها</h3>
        <a asp-action="Create" class="btn btn-primary float-left">ایجاد بخش جدید</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
            <tr>
                <th>شناسه</th>
                <th>نام</th>
                <th>توضیحات</th>
                <th>ترتیب</th>
                <th>فعال</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.DisplayOrder</td>
                    <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">ویرایش</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('آیا مطمئن هستید؟')">حذف</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>