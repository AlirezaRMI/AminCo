@model Application.DTOs.Sections.CreateSectionDto
@{
    ViewData["Title"] = "ایجاد بخش";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="card-dashboard p-4">
    <h2>ایجاد بخش جدید</h2>
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>نام بخش</label>
            <input asp-for="Name" class="form-control bg-dark text-white" required />
        </div>
        <div class="mb-3">
            <label>توضیحات</label>
            <textarea asp-for="Description" class="form-control bg-dark text-white" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label>آیکون (کلاس FontAwesome یا مسیر)</label>
            <input asp-for="Icon" class="form-control bg-dark text-white" placeholder="fas fa-cog" />
        </div>
        <div class="mb-3">
            <label>ترتیب نمایش</label>
            <input asp-for="DisplayOrder" class="form-control bg-dark text-white" type="number" value="0" />
        </div>
        <button type="submit" class="btn btn-gold">ذخیره</button>
        <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
    </form>
</div>