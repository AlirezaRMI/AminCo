@model Application.DTOs.Categories.CategoryDto
@{
    ViewData["Title"] = "جزئیات دسته‌بندی";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="card-dashboard p-4">
    <h2>@Model.Name</h2>
    <p><strong>توضیحات:</strong> @Model.Description</p>
    <p><strong>بخش:</strong> @Model.SectionName</p>
    <p><strong>تصویر:</strong> @Model.ImageUrl</p>
    <p><strong>فعال:</strong> @(Model.IsActive ? "بله" : "خیر")</p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">ویرایش</a>
    <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
</div>