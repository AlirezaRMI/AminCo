@model Web.Areas.Admin.Controllers.UserRolesManagementViewModel
@{
    ViewData["Title"] = "مدیریت نقش‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="card-dashboard p-4">
    <h2>مدیریت نقش‌های کاربر: @Model.UserName</h2>
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <div class="mb-3">
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="form-check">
                    <input type="hidden" asp-for="@Model.Roles[i].RoleId" />
                    <input type="hidden" asp-for="@Model.Roles[i].RoleName" />
                    <input asp-for="@Model.Roles[i].IsAssigned" class="form-check-input" />
                    <label class="form-check-label">@Model.Roles[i].RoleName</label>
                </div>
            }
        </div>
        <button type="submit" class="btn btn-gold">ذخیره تغییرات</button>
        <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
    </form>
</div>