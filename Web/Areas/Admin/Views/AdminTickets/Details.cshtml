@model Application.DTOs.Ticket.TicketResponseDto
@{
    ViewData["Title"] = "جزئیات تیکت";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="card-dashboard p-4">
    <h2>@Model.Title</h2>
    <p><strong>کاربر:</strong> @Model.CreatedByUserName</p>
    <p><strong>اولویت:</strong> @Model.Priority</p>
    <p><strong>وضعیت:</strong> @Model.Status</p>
    <p><strong>توضیحات:</strong> @Model.Description</p>
    <hr />
    <h4>پاسخ‌ها</h4>
    @foreach (var reply in Model.Replies)
    {
        <div class="border-bottom mb-2 pb-2">
            <strong>@reply.UserName</strong> ( @reply.CreatedAt.ToString("yyyy/MM/dd HH:mm") )<br />
            @reply.Message
            @if (reply.IsInternalNote) { <span class="badge bg-secondary">یادداشت داخلی</span> }
        </div>
    }
    <hr />
    <h4>افزودن پاسخ</h4>
    <form method="post" asp-action="AddReply">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ticketId" value="@Model.Id" />
        <div class="mb-3">
            <textarea name="message" class="form-control bg-dark text-white" rows="4" required></textarea>
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" name="isInternalNote" class="form-check-input" value="true" id="internalNote" />
            <label class="form-check-label" for="internalNote">یادداشت داخلی (فقط برای ادمین‌ها)</label>
        </div>
        <button type="submit" class="btn btn-gold">ارسال پاسخ</button>
    </form>

    <div class="mt-3">
        <form method="post" asp-action="TakeTicket" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-warning">اختصاص به من</button>
        </form>
        <form method="post" asp-action="ChangeStatus" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="status" class="form-select d-inline w-auto">
                @foreach (var s in Enum.GetValues<Domain.Enums.TicketStatus>())
                {
                    <option value="@s" selected="@(s == Model.Status ? "selected" : null)">@s</option>
                }
            </select>
            <button type="submit" class="btn btn-success">تغییر وضعیت</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
    </div>
</div>