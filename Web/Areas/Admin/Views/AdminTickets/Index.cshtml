@model IReadOnlyList<Application.DTOs.Ticket.TicketSummaryDto>
@{
    ViewData["Title"] = "تیکت‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex justify-content-between mb-3">
    <h2>مدیریت تیکت‌ها</h2>
</div>
<table class="table table-dark table-bordered">
    <thead>
    <tr><th>عنوان</th><th>کاربر</th><th>اولویت</th><th>وضعیت</th><th>تاریخ</th><th>عملیات</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.CreatedByUserName</td>
            <td>@item.Priority</td>
            <td>@item.Status</td>
            <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
            <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">مشاهده</a></td>
        </tr>
    }
    </tbody>
</table>