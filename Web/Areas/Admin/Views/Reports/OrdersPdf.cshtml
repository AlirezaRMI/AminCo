@model IReadOnlyList<Application.DTOs.Orders.OrderDto>
<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>لیست سفارشات</title>
    <style>
        body { font-family: 'Vazirmatn', Tahoma, sans-serif; font-size: 12pt; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: right; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
<h2>گزارش سفارشات</h2>
<table>
    <thead>
    <tr><th>شناسه</th><th>کاربر</th><th>تاریخ</th><th>مبلغ کل</th><th>وضعیت</th><th>پرداخت</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.UserId</td> <!-- در صورت نیاز نام کاربر -->
            <td>@item.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
            <td>@item.TotalAmount.ToString("N0")</td>
            <td>@item.Status</td>
            <td>@(item.IsPaid ? "پرداخت شده" : "پرداخت نشده")</td>
        </tr>
    }
    </tbody>
</table>
</body>
</html>