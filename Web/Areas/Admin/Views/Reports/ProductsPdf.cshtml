@model IReadOnlyList<Application.DTOs.Products.ProductDto>
<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>لیست محصولات</title>
    <style>
        body { font-family: 'Vazirmatn', Tahoma, sans-serif; font-size: 12pt; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: right; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
<h2>گزارش محصولات</h2>
<table>
    <thead>
    <tr><th>شناسه</th><th>نام</th><th>قیمت</th><th>تخفیف</th><th>موجودی</th><th>دسته</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price.ToString("N0")</td>
            <td>@(item.DiscountPrice?.ToString("N0") ?? "-")</td>
            <td>@item.StockQuantity</td>
            <td>@item.CategoryName</td>
        </tr>
    }
    </tbody>
</table>
</body>
</html>