@model IReadOnlyList<Application.DTOs.Invoices.InvoiceDto>
@{
    ViewData["Title"] = "فاکتورها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex justify-content-between mb-3">
    <h2>لیست فاکتورها</h2>
</div>
<table class="table table-dark table-bordered">
    <thead>
    <tr><th>شماره فاکتور</th><th>سفارش</th><th>مبلغ</th><th>تاریخ</th><th>نهایی</th><th>عملیات</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.InvoiceNumber</td>
            <td><a asp-action="Details" asp-controller="Orders" asp-route-id="@item.OrderId">#@item.OrderId</a></td>
            <td>@item.Amount.ToString("N0") تومان</td>
            <td>@item.InvoiceDate.ToString("yyyy/MM/dd")</td>
            <td>@(item.IsFinal ? "نهایی" : "پیش‌فاکتور")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">جزئیات</a>
                @if (!item.IsFinal)
                {
                    <a asp-action="Finalize" asp-route-orderId="@item.OrderId" class="btn btn-sm btn-success">نهایی کردن</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>