@{
    Layout = null;
    ViewData["Title"] = "About Us | Amin Co";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/public/css/main.css">
    <link rel="stylesheet" href="~/public/css/setting.css">
    <style>
        .about-page {
            background: #171818;
            min-height: 100vh;
            padding: 0 20px 60px;
            font-family: 'Vazirmatn', Tahoma, sans-serif;
        }
        .about-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .about-hero {
            text-align: center;
            padding: 60px 20px 40px;
        }
        .about-hero h1 {
            color: #B54D60;
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .about-hero p {
            color: #aaa;
            font-size: 18px;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.7;
        }
        .about-video-wrap {
            margin: 0 auto 60px;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            border: 1px solid rgba(181, 77, 96, 0.2);
        }
        .about-video-wrap video {
            width: 100%;
            height: auto;
            display: block;
        }
        .about-section {
            display: flex;
            align-items: center;
            gap: 50px;
            margin-bottom: 70px;
            padding: 20px 0;
        }
        .about-section.reverse {
            flex-direction: row-reverse;
        }
        .about-section .about-image {
            flex: 1;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
            border: 1px solid rgba(181, 77, 96, 0.15);
        }
        .about-section .about-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }
        .about-section .about-image:hover img {
            transform: scale(1.02);
        }
        .about-section .about-text {
            flex: 1;
            padding: 10px 0;
        }
        .about-section .about-text h2 {
            color: #B54D60;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 16px;
        }
        .about-section .about-text p {
            color: #ccc;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 12px;
        }
        .about-section .about-text .highlight {
            color: #B54D60;
            font-weight: 600;
        }
        @@media (max-width: 768px) {
            .about-hero h1 { font-size: 32px; }
            .about-hero p { font-size: 15px; }
            .about-section {
                flex-direction: column !important;
                gap: 25px;
                margin-bottom: 50px;
            }
            .about-section .about-text {
                text-align: center;
                padding: 0 10px;
            }
            .about-section .about-text h2 { font-size: 26px; }
            .about-section .about-text p { font-size: 14px; }
            .about-video-wrap { margin-bottom: 40px; }
        }
    </style>
</head>
<body class="about-page">

<partial name="_Header" />

<div class="about-container">
    <div class="about-hero reveal from-top">
        <h1 data-i18n="about_hero_title">About Amin Co</h1>
        <p data-i18n="about_hero_desc">Designing, manufacturing and supplying modern industrial kitchen equipment for hotels, restaurants and large commercial kitchens across Iran.</p>
    </div>

    <div class="about-video-wrap reveal from-bottom">
        <video autoplay muted loop playsinline>
            <source src="~/public/img/about_us/video/-5832957886656549323.MP4" type="video/mp4">
        </video>
    </div>

    <div class="about-section reveal from-left">
        <div class="about-image">
            <img src="~/public/img/about_us/section1.jpg" alt="Design">
        </div>
        <div class="about-text">
            <h2 data-i18n="about_section1_title">Design & Engineering</h2>
            <p data-i18n="about_section1_text">We create functional and aesthetic kitchen layouts using advanced CAD tools. Every square meter is optimized for workflow, safety and efficiency.</p>
            <p data-i18n="about_section1_text2">Our team of experienced engineers ensures that every project meets international standards while being tailored to local needs.</p>
        </div>
    </div>

    <div class="about-section reverse reveal from-right">
        <div class="about-image">
            <img src="~/public/img/about_us/section2.jpg" alt="Manufacturing">
        </div>
        <div class="about-text">
            <h2 data-i18n="about_section2_title">High‑Quality Manufacturing</h2>
            <p data-i18n="about_section2_text">Using premium stainless steel and advanced machinery, we produce durable and reliable kitchen equipment — from ovens and ranges to ventilation hoods and refrigeration units.</p>
            <p data-i18n="about_section2_text2">Every product undergoes strict quality control before leaving our workshop.</p>
        </div>
    </div>

    <div class="about-section reveal from-left">
        <div class="about-image">
            <img src="~/public/img/about_us/section3.jpg" alt="Supply">
        </div>
        <div class="about-text">
            <h2 data-i18n="about_section3_title">Reliable Supply Chain</h2>
            <p data-i18n="about_section3_text">We partner with leading global and local brands to bring you the best equipment at competitive prices. From planning to delivery, we handle everything.</p>
            <p data-i18n="about_section3_text2">Our logistics team ensures that your equipment arrives on time and in perfect condition.</p>
        </div>
    </div>

    <div class="about-section reverse reveal from-right">
        <div class="about-image">
            <img src="~/public/img/about_us/section4.jpg" alt="Support">
        </div>
        <div class="about-text">
            <h2 data-i18n="about_section4_title">Installation & After‑Sales</h2>
            <p data-i18n="about_section4_text">Our certified technicians install every piece of equipment with precision and care. We provide full training for your staff and offer 24/7 after‑sales support.</p>
            <p data-i18n="about_section4_text2">With spare parts and maintenance contracts, we keep your kitchen running smoothly for years.</p>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="~/public/js/animate.js"></script>
<script src="~/public/i18next/dist/umd/i18next.js"></script>
<script src="~/public/js/language.js"></script>
<script src="~/public/js/languagebtn.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof setLanguage === 'function') {
            setLanguage('en');
        }
    });
</script>
</body>
</html>