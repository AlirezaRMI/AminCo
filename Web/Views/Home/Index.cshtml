@model HomePageViewModel
@{
    ViewData["Title"] = "Home | Amin Co";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="wraper">
    <header class="top_header relative">
        <nav class="nav_header reveal from-top">
            <div class="header_logo">
                <img src="~/public/img/header/AMINCO.png" alt="AminCo">
            </div>
            <ul class="ul_header">
                <li><a data-i18n="con-us" href="#">Contact Us</a></li>
                <li><a data-i18n="news" href="#">News</a></li>
                <li class="relative" id="dropdown-parent">
                    <a data-i18n="products" href="#" class="flex items-center gap-1" id="dropdown-btn">Products</a>
                    <ul id="dropdown-menu" class="drop_ul">
                        <li><a href="#" class="drop_li">Kitchen Equipment</a></li>
                        <li><a href="#" class="drop_li">Restaurant Equipment</a></li>
                        <li><a href="#" class="drop_li">Installation Services</a></li>
                        <li><a href="#" class="drop_li">Free Consulting</a></li>
                    </ul>
                </li>
                <li>
                    <button class="lang-btn" id="langBtn" onclick="toggleLang()">
                        <div class="lang-track"></div>
                        <span class="lang-option active" id="enOpt">EN</span>
                        <span class="lang-option inactive" id="faOpt">FA</span>
                    </button>
                </li>
            </ul>
        </nav>

        <div class="header_small_baners reveal from-left">
            <div class="small_baner_top" data-tilt>
                <div class="smal_baner_txts">
                    <div class="aroow">
                        <div class="curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                    </div>
                    <div class="small_baner_txt_wraper">
                        <div class="smal_baber_light_txt"><p data-i18n="economy_package">Economy Package</p></div>
                        <div class="smal_baber_bold_txt"><p data-i18n="restaurant_setup">Restaurant Setup</p></div>
                    </div>
                </div>
                <div class="small_baner_img_wraper"><img
                        src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt=""></div>
            </div>
            <div class="small_baner_bottom" data-tilt>
                <div class="smal_baner_txts_bottom">
                    <div class="aroow">
                        <div class="curcle_bottom"><img src="~/public/img/header/whiteArrow.png" alt=""></div>
                    </div>
                    <div class="small_baner_txt_wraper">
                        <div class="smal_baber_light_txt_bottom"><p data-i18n="economy_package">Economy Package</p>
                        </div>
                        <div class="smal_baber_bold_txt_bottom"><p data-i18n="restaurant_setup">Restaurant Setup</p>
                        </div>
                    </div>
                </div>
                <div class="small_baner_img_wraper"><img
                        src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt=""></div>
            </div>
        </div>

        <div class="w-[75%] h-full reveal from-right">
            <div class="header_rounded_baner" data-tilt data-tilt-strength="5">
                <div class="rounded_img">
                    <img src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt="">
                </div>
                <div class="rounded_txt">
                    <div class="rounded_light_txt"><p data-i18n="desigin"></p></div>
                    <div class="rounded_bold_txt">
                        <p data-i18n="Industrial">@(Model.AboutUs?.Title ?? "Industrial Kitchen Equipment")</p>
                    </div>
                    <div class="rounded_dec">
                        <p>@(Model.AboutUs?.Content?.Length > 150 ? Model.AboutUs.Content.Substring(0, 150) + "..." : Model.AboutUs?.Content)</p>
                    </div>
                    <div class="header_btn_wraper">
                        <a class="header_btn reveal from-right" href="/Home/UnderConstruction">
                            <div class="counsel_curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                            <div class="counsel_link_txt"><p data-i18n="view_services">View Services</p></div>
                        </a>
                    </div>
                </div>
                <div class="statistics">
                    <div class="statistics_box">
                        <span data-target="@Model.StatCustomers">0</span>
                        <p class="statistics_dec" data-i18n="happy_customers">Happy Customers</p>
                    </div>
                    <div class="line"></div>
                    <div class="statistics_box">
                        <span data-target="@Model.StatProjects">0</span>
                        <p class="statistics_dec" data-i18n="projects_completed">Projects Completed</p>
                    </div>
                    <div class="line"></div>
                    <div class="statistics_box">
                        <span data-target="@Model.StatYears">0</span>
                        <p class="statistics_dec" data-i18n="years_experience">Years Experience</p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ========== هدر موبایل (همان با متن انگلیسی) ========== -->
    <header class="mobile_header">
        <div class="mobile_menu_wraper reveal from-top">
            <button class="burger_btn_wraper" id="burger-btn">
                <span class="burger-line"></span><span class="burger-line"></span><span class="burger-line"></span>
            </button>
            <div id="mobile-menu" class="mobile_menu">
                <ul class="mobile_ul">
                    <li><a href="#" class="mobile_li" data-i18n="con-us">Contact Us</a></li>
                    <li><a href="#" class="mobile_li" data-i18n="news">News</a></li>
                    <li class="flex flex-col items-center gap-3 w-full text-center">
                        <a href="#" class="flex items-center justify-center gap-2" id="mobile-dropdown-btn">
                            <span data-i18n="products">Products & Services</span>
                            <svg id="mobile-arrow" class="w-3 h-3 transition-transform duration-300" viewBox="0 0 12 12"
                                 fill="none">
                                <path d="M2 4L6 8L10 4" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </a>
                        <ul id="mobile-dropdown" class="mobile_drop_ul">
                            <li><a href="#" class="mobile_drop_li">Kitchen Equipment</a></li>
                            <li><a href="#" class="mobile_drop_li">Restaurant Equipment</a></li>
                            <li><a href="#" class="mobile_drop_li">Installation Services</a></li>
                            <li><a href="#" class="mobile_drop_li">Free Consulting</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
            <button class="lang-btn z-50" id="langBtn_mobile" onclick="toggleLang()">
                <div class="lang-track"></div>
                <span class="lang-option active" id="enOpt_mobile">EN</span>
                <span class="lang-option inactive" id="faOpt_mobile">FA</span>
            </button>
        </div>
        <div class="mobile_rounded_baner reveal from-left">
            <div class="mobile_rounded_baner_txt_wraper">
                <div class="mobile_rounded_baner_txt_light"><p data-i18n="desigin"></p></div>
                <div class="mobile_rounded_baner_txt_bold"><p data-i18n="Industrial">Industrial Kitchen Equipment</p>
                </div>
            </div>
            <div class="mobile_rounded_img_wraper">
                <div class="mobile_rounded_section">
                    <div class="mobile_rounded_btn">
                        <div class="counsel_curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                        <div class="counsel_link_txt"><p data-i18n="view_services">View Services</p></div>
                    </div>
                    <div class="nums">
                        <div class="statistics">
                            <div class="statistics_box"><span data-target="4000">0</span>
                                <p class="statistics_dec" data-i18n="happy_customers">Happy Customers</p></div>
                            <div class="line"></div>
                            <div class="statistics_box"><span data-target="34500">0</span>
                                <p class="statistics_dec" data-i18n="projects_completed">Projects Completed</p></div>
                            <div class="line"></div>
                            <div class="statistics_box"><span data-target="100">0</span>
                                <p class="statistics_dec" data-i18n="years_experience">Years Experience</p></div>
                        </div>
                    </div>
                </div>
                <div class="mobile_rounded_section"><img
                        src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt=""></div>
            </div>
        </div>
        <div class="mobile_small_section_wraper">
            <div class="mobile_small_baner_l reveal from-left">
                <img class="object-scale-down"
                     src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt="">
                <div class="smal_baner_mobile_txt_wraper">
                    <div class="counsel_curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                    <div class="small_baner_txt_wraper">
                        <div class="smal_baber_light_txt"><p data-i18n="economy_package">Economy Package</p></div>
                        <div class="smal_baber_bold_txt"><p data-i18n="restaurant_setup">Restaurant Setup</p></div>
                    </div>
                </div>
            </div>
            <div class="mobile_small_baner_r reveal from-right">
                <img class="object-scale-down"
                     src="~/public/img/header/item_img/file_00000000e268720a840863324aa5bf15 1.png" alt="">
                <div class="smal_baner_mobile_txt_wraper">
                    <div class="counsel_curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                    <div class="small_baner_txt_wraper">
                        <div class="smal_baber_light_txt"><p data-i18n="economy_package">Economy Package</p></div>
                        <div class="smal_baber_bold_txt"><p data-i18n="restaurant_setup">Restaurant Setup</p></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ========== اسلایدر ========== -->
    <section class="sliders_wraper">
        <div class="slider_l reveal from-left">
            <div class="slider_link">
                <div class="svg_link">
                    <div class="curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                </div>
                <div class="txt_link"><p data-i18n="more_info">More Info</p></div>
            </div>
            <img class="slider_img_l" src="~/public/img/slider/be401fe22be8e7c8de1fd25af44a40083a5fd4db.jpg" alt="">
            <div class="slider_r_txt"><p data-i18n="economy_package_restaurant">Economy Restaurant Package</p></div>
        </div>
        <div class="slider_r reveal from-right">
            <div class="slider_link">
                <div class="svg_link">
                    <div class="curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                </div>
                <div class="txt_link"><p data-i18n="more_info">More Info</p></div>
            </div>
            <div class="slider_img_wraper">
                <img class="slider_img_r" src="~/public/img/slider/373bf71029f1da36a550ede13341184ecb1efb8b.png" alt="">
                <img class="slider_img_r" src="~/public/img/slider/76a498113b01496ae01e2d24bb8b4099f4e58b35.png" alt="">
                <img class="slider_img_r" src="~/public/img/slider/868db20882489476420c0a166f66863e90bb3c96.jpg" alt="">
                <img class="slider_img_r" src="~/public/img/slider/be401fe22be8e7c8de1fd25af44a40083a5fd4db.jpg" alt="">
            </div>
        </div>
    </section>

    <!-- ========== خدمات (داینامیک از دیتابیس) ========== -->
    <section class="services">
        <div class="service_title">
            <h1 class="service_title_txt reveal from-left" data-i18n="our_services">!Our Services</h1>
            <p class="service_dec reveal from-right" data-i18n="services_desc">Professional solutions for your
                industrial kitchen needs.</p>
        </div>
        <div class="service_box_wraper text-center">
            @if (Model.Services != null && Model.Services.Any())
            {
                foreach (var service in Model.Services)
                {
                    <div class="service_box group reveal from-top">
                        <div class="hover_service_box"></div>
                        <div class="box_title"><h3>@service.Title</h3></div>
                        <div class="box_txt"><p>@service.Description</p></div>
                    </div>
                }
            }
            else
            {
                <div class="service_box group reveal from-top">
                    <div class="hover_service_box"></div>
                    <div class="box_title"><h3>Design & Consultation</h3></div>
                    <div class="box_txt"><p>Expert layout design for your kitchen.</p></div>
                </div>
                <div class="service_box group reveal from-top">
                    <div class="hover_service_box"></div>
                    <div class="box_title"><h3>Equipment Supply</h3></div>
                    <div class="box_txt"><p>High-quality industrial appliances.</p></div>
                </div>
                <div class="service_box group reveal from-top">
                    <div class="hover_service_box"></div>
                    <div class="box_title"><h3>Installation</h3></div>
                    <div class="box_txt"><p>Professional setup and testing.</p></div>
                </div>
                <div class="service_box group reveal from-top">
                    <div class="hover_service_box"></div>
                    <div class="box_title"><h3>Maintenance</h3></div>
                    <div class="box_txt"><p>24/7 after-sales support.</p></div>
                </div>
            }
        </div>
    </section>

    <section class="swiper_wraper">
        <div class="swiper_txt_wraper reveal from-right">
            <div class="swiper_link_wraper">
                <a href="/Home/UnderConstruction" class="swiper_link reveal from-right">
                    <img class="w-5 h-3.5" src="~/public/img/news/svgs/Vector 2343.png" alt="">
                    <p data-i18n="view_all">View All</p>
                </a>
            </div>
            <div class="swiper_txt">
                <div class="swiper_txt_bold"><p data-i18n="latest_projects">Latest Projects</p></div>
                <div class="swiper_txt_light"><p data-i18n="see_projects">See the latest projects of Amin Co.</p></div>
            </div>
        </div>
        <div class="section">
            <div class="carousel-section">
                <div class="carousel-wrap" id="carousel">
                    <div class="carousel-track" id="track">
                        @if (Model.Portfolios != null)
                        {
                            foreach (var portfolio in Model.Portfolios)
                            {
                                var mainImage = portfolio.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? portfolio.Images.FirstOrDefault()?.ImageUrl ?? "~/public/img/swiper/pexels-pixabay-41953.jpg";
                                <div class="card">
                                    <img src="@mainImage" alt="@portfolio.Title">
                                    <div class="card-caption">
                                        <h3>@portfolio.Title</h3>
                                        <a href="/Home/UnderConstruction">
                                            <span data-i18n="details">Details</span>
                                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                                <path d="M10 7H4M4 7L7 4M4 7L7 10" stroke="currentColor"
                                                      stroke-width="1.4" stroke-linecap="round"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="desktop-nav">
                    <div class="nav-btn" id="btn-prev">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M10 12L6 8L10 4" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="dots" id="dots"></div>
                    <div class="nav-btn" id="btn-next">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M6 4L10 8L6 12" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="mobile-slider">
                <div class="mobile-track-wrap">
                    <div class="mobile-track" id="m-track">
                        @if (Model.Portfolios != null)
                        {
                            foreach (var portfolio in Model.Portfolios)
                            {
                                var mainImage = portfolio.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? portfolio.Images.FirstOrDefault()?.ImageUrl ?? "~/public/img/swiper/pexels-pixabay-41953.jpg";
                                <div class="mobile-card">
                                    <img src="@mainImage" alt="@portfolio.Title">
                                    <div class="mobile-caption">
                                        <h3>@portfolio.Title</h3>
                                        <a href="/Home/UnderConstruction">
                                            <span data-i18n="details">Details</span>
                                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                                <path d="M10 7H4M4 7L7 4M4 7L7 10" stroke="currentColor"
                                                      stroke-width="1.4" stroke-linecap="round"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="mobile-nav">
                    <div class="mobile-nav-btn" id="m-prev">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M10 12L6 8L10 4" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="mobile-dots" id="m-dots"></div>
                    <div class="mobile-nav-btn" id="m-next">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M6 4L10 8L6 12" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="cooperation_pattern"><img src="~/public/img/cooperation/pattern.png" alt=""></div>
    </section>

    <!-- ========== درباره ما (داینامیک) ========== -->
    <section class="aboutus">
        <div class="amin_logo reveal from-left"><img class="w-1/2 h-full object-scale-down"
                                                     src="~/public/img/about_us/AMINCO.png" alt="AminCo"></div>
        <div class="aboutus_more">
            <div class="aboutus_video_wraper reveal from-left">
                <video class="about_us_video" autoplay muted loop playsinline
                       src="~/public/img/about_us/video/-5832957886656549323.MP4"></video>
            </div>
            <div class="aboutus_txt">
                <div class="texts reveal from-right">
                    <div class="txt"><h3 data-i18n="about_us">About Us</h3></div>
                    <div class="txt_bold"><h3 data-i18n="learn_more">!Learn More</h3></div>
                </div>
                <div class="txt_dec no-scrollbar reveal from-bottom">
                    @Html.Raw(Model.AboutUs?.Content?.Replace("\n", "<br/>") ?? "Default about us text")
                </div>
                <div class="social_pages">
                    <a href="#" class="curcle_social_page reveal from-bottom"><img class="icn"
                                                                                   src="~/public/img/about_us/pges_svg/Shape.png"
                                                                                   alt=""></a>
                    <a href="#" class="curcle_social_page_in reveal from-top"><img class="icn"
                                                                                   src="~/public/img/about_us/pges_svg/linkedin-fill-svgrepo-com 1.png"
                                                                                   alt=""></a>
                    <a href="#" class="curcle_social_page reveal from-bottom"><img class="icn"
                                                                                   src="~/public/img/about_us/pges_svg/Vector (6).png"
                                                                                   alt=""></a>
                    <a href="#" class="curcle_social_page reveal from-left"><img class="icn"
                                                                                 src="~/public/img/about_us/pges_svg/Vector (7).png"
                                                                                 alt=""></a>
                </div>
            </div>
        </div>
    </section>
    
    <section class="cooperation reveal from-bottom">
        <div class="cooperation_txts">
            <div class="cooperation_header reveal from-left"><h3 data-i18n="cooperation_header">We are proud to cooperate with</h3></div>
            <div class="cooperation_header_bold reveal from-right"><h3 data-i18n="cooperation_bold">Trusted partners across Iran</h3></div>
            <div class="cooperation_dec reveal from-bottom"><p data-i18n="cooperation_desc">Leading companies that trust Amin Co for their kitchen equipment needs.</p></div>
        </div>
        <div class="companys">
            @if (Model.Partners != null && Model.Partners.Any())
            {
                var partnersList = Model.Partners.ToList();
                int half = (int)Math.Ceiling(partnersList.Count / 2.0);
                var firstRow = partnersList.Take(half);
                var secondRow = partnersList.Skip(half);

                <div class="company_section reveal from-left text-center">
                    @foreach (var partner in firstRow)
                    {
                        <div class="company_style_odd group">
                            <div class="hover_company_style_odd"></div>
                            <p class="z-10">@partner.Name</p>
                        </div>
                    }
                </div>
                <div class="company_section reveal from-right">
                    @foreach (var partner in secondRow)
                    {
                        <div class="company_style_even group">
                            <div class="hover_company_style_even"></div>
                            <p class="z-10">@partner.Name</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- fallback static content -->
                <div class="company_section reveal from-left">
                    <div class="company_style_odd group"><div class="hover_company_style_odd"></div><p class="z-10">AZARIN</p></div>
                    <div class="company_style_even group"><div class="hover_company_style_even"></div><p class="z-10">GOLRANG</p></div>
                    <div class="company_style_odd group"><div class="hover_company_style_odd"></div><p class="z-10">PERSIAN VENT</p></div>
                </div>
                <div class="company_section reveal from-right">
                    <div class="company_style_even group"><div class="hover_company_style_even"></div><p class="z-10">TEHRAN STEEL</p></div>
                    <div class="company_style_odd group"><div class="hover_company_style_odd"></div><p class="z-10">IRAN HOTELIERS</p></div>
                </div>
            }
        </div>
        <div class="cooperation_pattern"><img src="~/public/img/cooperation/pattern.png" alt=""></div>
        <div class="cooperation_flash"><img src="~/public/img/cooperation/Flash.png" alt=""></div>
    </section>

    <!-- ========== مشاوره ========== -->
    <section class="counsel">
        <div class="counsel_box reveal from-right">
            <div class="counsel_box_wraper">
                <div class="counsoel_dec reveal from-bottom"><p data-i18n="counsel_text">Our experts will guide you in
                        developing your business.</p></div>
                <div class="counsel_txt_wraper reveal from-top">
                    <div class="counsel_txt"><p data-i18n="need">Need</p></div>
                    <div class="counsel_txt_bold"><p data-i18n="consultation">Consultation?</p></div>
                </div>
                <div class="xl:w-[441px] w-[150px] xl:h-[455px] h-[160px] absolute z-10 left-0"><img
                        class="object-scale-down" src="~/public/img/counsel/pattern.png" alt=""></div>
            </div>
        </div>
        <div class="counsel_link_wraper reveal from-left">
            <a class="counsel_link" href="#">
                <div class="counsel_curcle"><img src="~/public/img/slider/svg/direction.png" alt=""></div>
                <div class="counsel_link_txt"><p data-i18n="contact_us">Contact Us</p></div>
            </a>
        </div>
    </section>
<section class="news">
        <div class="news_txt reveal from-top">
            <div class="news_header"><h3 data-i18n="latest_news">Latest News & Articles</h3></div>
        </div>
        <div class="news_box_wraper">
            @if (Model.LatestArticles != null)
            {
                foreach (var article in Model.LatestArticles.Take(3))
                {
                    <div class="news_box group reveal from-left">
                        <div class="news_img_wraper">
                            <img class="news_img"
                                 src="@(article.MainImageUrl ?? "~/public/img/slider/be401fe22be8e7c8de1fd25af44a40083a5fd4db.jpg")"
                                 alt="@article.Title">
                            <div class="hover_news_img"></div>
                            <div class="news_btn_hover_wraper">
                                <a class="news_btn_hover" href="/Home/UnderConstruction"><span>←</span><span
                                        data-i18n="read_article">Read Article</span></a>
                            </div>
                        </div>
                        <div class="news_dec">
                            <div class="news_dec_header"><h3>@article.Title</h3></div>
                            <div class="news_dec_txt no-scrollbar"><p>@article.ShortDescription</p></div>
                            <div class="person_hour">
                                <div class="hour" dir="rtl">
                                    <img class="w-4.25 h-4.25" src="~/public/img/news/svgs/Time.png" alt="">
                                    <p>@((DateTime.Now - article.PublishDate).Days) <span
                                            data-i18n="days_ago">days ago</span></p>
                                </div>
                                <div class="person" dir="rtl">
                                    <img class="w-4.25 h-4.25 object-scale-down" src="~/public/img/news/svgs/Mail.png"
                                         alt="">
                                    <p data-i18n="editorial">Editorial</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            <a href="/Home/UnderConstruction" class="show_all_wraper reveal from-right">
                <img class="w-5 h-3.5" src="~/public/img/news/svgs/Vector 2343.png" alt="">
                <p data-i18n="view_all">View All</p>
            </a>
        </div>
    </section>

    <!-- ========== فرم تماس ========== -->
    <section class="contact_us">
        <div class="cooperation_txts reveal from-top">
            <div class="cooperation_header"><h3 data-i18n="free_consultation">Free Consultation</h3></div>
            <div class="cooperation_header_bold"><h3 data-i18n="contact_title">Get in touch</h3></div>
            <div class="cooperation_dec reveal from-bottom">
                <p>@(Model.ContactInfo?.Address ?? "Tehran, Valiasr St., No. 123")</p></div>
        </div>
        <form class="contact_us_form reveal from-bottom" asp-controller="Home" asp-action="SubmitContact" method="post">
            @Html.AntiForgeryToken()
            <label class="contact_us_lable reveal from-top" for="FullName" data-i18n="full_name">Full Name</label>
            <input class="contact_us_input reveal from-top" type="text" id="FullName" name="FullName"
                   placeholder="Farzad Hashemi" required>
            <label class="contact_us_lable reveal from-top" for="PhoneNumber" data-i18n="phone">Phone Number</label>
            <input class="contact_us_input reveal from-top" type="text" id="PhoneNumber" name="PhoneNumber"
                   placeholder="0913*******" required>
            <label class="contact_us_lable reveal from-top" for="Description"
                   data-i18n="description">Description</label>
            <input class="contact_us_input_dec reveal from-top" type="text" id="Description" name="Description">
            <div
                class="w-full h-[60px] text-white flex justify-end items-center gap-2 xl:text-[14px] font-normal text-[12px] text-right">
                <label class="reveal from-bottom" for="AgreePrivacy" data-i18n="agree_privacy">I agree to the privacy
                    policy</label>
                <input class="size-4" type="checkbox" id="AgreePrivacy" name="AgreePrivacy" value="true">
            </div>
            <button class="contact_us_form_btn reveal from-bottom" type="submit" data-i18n="send_message">Send Message
            </button>
        </form>
        <div class="top_pattern"><img src="~/public/img/contact_us/pattern/paatterntop.png" alt=""></div>
        <div class="bottom_pattern"><img src="~/public/img/contact_us/pattern/patternbottom.png" alt=""></div>
        <div class="flash_pattern"><img src="~/public/img/contact_us/flash.png" alt=""></div>
    </section>

    <!-- ========== بنر متحرک ========== -->
    <section class="baner_wraper">
        <div class="baner reveal from-left">
            <div class="scrool">
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
                <p>Amin Co</p>
            </div>
        </div>
        <div class="baner_rotate reveal from-right"></div>
    </section>

    <!-- ========== فوتر ========== -->
    <footer class="footer_wraper reveal from-bottom">
        <div class="footer_items">
            <div class="footer_curcle_wraper reveal from-left">
                <div class="footer_curcle">
                    <div class="footer_flash"><img src="~/public/img/footer/Arrow.png" alt=""></div>
                    <div class="text_curcle"><img src="~/public/img/footer/Group 2085663503 (1).png" alt=""></div>
                </div>
            </div>
            <div class="footer_header reveal from-right"><h3 data-i18n="com">@(Model.AboutUs?.Title ?? "Amin Co")</h3>
            </div>
            <div class="footer_dec reveal from-right"><p
                    data-i18n="f-dec">@(Model.ContactInfo?.Address ?? "Tehran, Valiasr St.")</p></div>
            <div class="footer_links reveal from-left">
                <a class="footer_last_link" href="/"><span data-i18n="home">Home</span></a>
                <a class="footer_link" href="/Home/UnderConstruction"><span data-i18n="services">Services</span></a>
                <a class="footer_link" href="/Home/UnderConstruction"><span data-i18n="portfolio">Portfolio</span></a>
                <a class="footer_first_link" href="/Home/UnderConstruction"><span data-i18n="contact">Contact</span></a>
            </div>
            <div class="footer_txt reveal from-bottom"><p data-i18n="copyright">All rights reserved by Amin Co.</p>
            </div>
        </div>
    </footer>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof VanillaTilt !== 'undefined') {
                VanillaTilt.init(document.querySelectorAll("[data-tilt]"), {max: 5, speed: 400});
            }
        });
    </script>
}