    <div id="contactModal" class="contact-modal" style="display:none;">
        <div class="contact-modal-content">
            <div class="contact-modal-icon" id="modalIcon">✅</div>
            <h3 id="modalTitle">موفق</h3>
            <p id="modalMessage">پیام شما با موفقیت ارسال شد.</p>
            <button class="contact-modal-btn" id="modalCloseBtn">باشه</button>
        </div>
