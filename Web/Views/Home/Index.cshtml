                                    data-i18n-key="article_title_@article.Id">@article.Title</h3></div>
                            <div class="news_dec_txt no-scrollbar"><p
                                    data-i18n-key="article_desc_@article.Id">@article.ShortDescription</p></div>
                            <div class="person_hour">
