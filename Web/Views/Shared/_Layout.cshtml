<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/public/css/main.css">
    <link rel="stylesheet" href="~/public/css/setting.css">
</head>
<body class="bg-[#171818] overflow-x-hidden">
@if (TempData["ContactSuccess"] != null)
{
    <div class="alert alert-success text-center" style="color: #28a745; background: #d4edda; padding: 10px; border-radius: 10px; margin-bottom: 15px;">
        @TempData["ContactSuccess"]
    </div>
}
@if (TempData["ContactError"] != null)
{
    <div class="alert alert-danger text-center" style="color: #721c24; background: #f8d7da; padding: 10px; border-radius: 10px; margin-bottom: 15px;">
        @TempData["ContactError"]
    </div>
}
@RenderBody()

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanilla-tilt@1.7.0/dist/vanilla-tilt.min.js"></script>
<script src="~/public/i18next/dist/umd/i18next.js"></script>
<script src="~/public/js/count.js"></script>
<script src="~/public/js/animate.js"></script>
<script src="~/public/js/headeranimate.js"></script>
<script src="~/public/js/swiper.js"></script>
<script src="~/public/js/menu.js"></script>
<script src="~/public/js/language.js"></script>
<script src="~/public/js/languagebtn.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>