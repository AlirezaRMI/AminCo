@{
    var currentUrl = Context.Request.Path.ToString();
}
<header class="site-header">
    <nav class="nav_header_global reveal from-top">
        <div class="header_logo">
            <a href="/">
                <img src="~/public/img/header/AMINCO.png" alt="AminCo">
            </a>
        </div>

        <ul class="ul_header_global">
            <li><a href="/" class="@(currentUrl == "/" ? "active" : "")" data-i18n="home">Home</a></li>
            <li><a href="/AboutUs" class="@(currentUrl.Contains("/AboutUs") ? "active" : "")" data-i18n="about_us">About Us</a></li>
            <li><a href="/Services" class="@(currentUrl.Contains("/Services") ? "active" : "")" data-i18n="services">Services</a></li>
            <li><a href="#contact" data-i18n="contact_us">Contact</a></li>
            <li>
                <button class="lang-btn" id="langBtn" onclick="toggleLang()">
                    <div class="lang-track"></div>
                    <span class="lang-option active" id="enOpt">EN</span>
                    <span class="lang-option inactive" id="faOpt">FA</span>
                </button>
            </li>
        </ul>

        <button class="burger_btn_global" id="burgerBtnGlobal">
            <span class="burger-line"></span>
            <span class="burger-line"></span>
            <span class="burger-line"></span>
        </button>

        <div id="mobileMenuGlobal" class="mobile_menu_global">
            <ul class="mobile_ul_global">
                <li><a href="/" data-i18n="home">Home</a></li>
                <li><a href="/AboutUs" data-i18n="about_us">About Us</a></li>
                <li><a href="/Services" data-i18n="services">Services</a></li>
                <li><a href="#contact" data-i18n="contact_us">Contact</a></li>
                <li>
                    <button class="lang-btn" id="langBtnMobileGlobal" onclick="toggleLang()">
                        <div class="lang-track"></div>
                        <span class="lang-option active" id="enOptMobileGlobal">EN</span>
                        <span class="lang-option inactive" id="faOptMobileGlobal">FA</span>
                    </button>
                </li>
            </ul>
        </div>
    </nav>
</header>

<style>
    .site-header {
        position: relative;
        z-index: 100;
        width: 100%;
        padding: 0 20px;
        background: #171818;
    }

    .nav_header_global {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 90px;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 10px;
    }

    .header_logo img {
        height: 45px;
        width: auto;
    }

    .ul_header_global {
        display: flex;
        align-items: center;
        gap: 40px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ul_header_global li a {
        color: #e5e7eb;
        font-size: 16px;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
        position: relative;
    }

    .ul_header_global li a:hover {
        color: #B54D60; /* زرشکی روشن‌تر */
    }

    .ul_header_global li a.active {
        color: #B54D60;
    }

    .ul_header_global li a.active::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 100%;
        height: 2px;
        background: #B54D60;
    }

    .burger_btn_global {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 10px;
        z-index: 60;
    }

    .burger_btn_global .burger-line {
        width: 28px;
        height: 2px;
        background: #fff;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .burger_btn_global.active .burger-line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }
    .burger_btn_global.active .burger-line:nth-child(2) {
        opacity: 0;
    }
    .burger_btn_global.active .burger-line:nth-child(3) {
        transform: rotate(-45deg) translate(5px, -5px);
    }

    .mobile_menu_global {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(17, 18, 18, 0.97);
        backdrop-filter: blur(12px);
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateY(-100%);
        transition: transform 0.4s ease;
    }

    .mobile_menu_global.open {
        transform: translateY(0);
    }

    .mobile_ul_global {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .mobile_ul_global li a {
        color: #fff;
        font-size: 22px;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    .mobile_ul_global li a:hover {
        color: #B54D60;
    }

    @@media (max-width: 768px) {
        .ul_header_global {
            display: none;
        }
        .burger_btn_global {
            display: flex;
        }
        .header_logo img {
            height: 35px;
        }
    }

    @@media (min-width: 769px) {
        .mobile_menu_global {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const burgerBtn = document.getElementById('burgerBtnGlobal');
        const mobileMenu = document.getElementById('mobileMenuGlobal');

        if (burgerBtn && mobileMenu) {
            burgerBtn.addEventListener('click', function () {
                this.classList.toggle('active');
                mobileMenu.classList.toggle('open');
                document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
            });

            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function () {
                    burgerBtn.classList.remove('active');
                    mobileMenu.classList.remove('open');
                    document.body.style.overflow = '';
                });
            });
        }
    });
</script>