@{
    ViewData["Title"] = "Under Construction | Amin Co";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="construction-wrapper">
    <div class="construction-card">
        <div class="animated-icon">
            <i class="fas fa-cog fa-spin" style="font-size: 80px; color: #f5c542;"></i>
        </div>
        <h1 data-i18n="under_construction">🚧 Under Construction 🚧</h1>
        <p data-i18n="construction_msg">This section is being developed. Thank you for your patience.</p>
        <div class="loader"></div>
        <a href="/" class="btn-home" data-i18n="back_home">Back to Home</a>
    </div>
</div>

<style>
    .construction-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        text-align: center;
        background: #171818;
        color: white;
        font-family: 'Vazirmatn', Tahoma, sans-serif;
    }
    .construction-card {
        background: rgba(20,20,20,0.8);
        backdrop-filter: blur(8px);
        padding: 2rem 3rem;
        border-radius: 40px;
        border: 1px solid rgba(255,215,0,0.3);
        box-shadow: 0 20px 35px rgba(0,0,0,0.5);
        max-width: 550px;
        width: 90%;
    }
    h1 {
        color: #f5c542;
        margin-bottom: 1rem;
    }
    p {
        color: #ccc;
        margin-bottom: 1.5rem;
    }
    .loader {
        width: 50px;
        height: 50px;
        border: 5px solid #333;
        border-top: 5px solid #f5c542;
        border-radius: 50%;
        margin: 1rem auto;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .btn-home {
        display: inline-block;
        background: #f5c542;
        color: #1a1a1a;
        padding: 8px 25px;
        border-radius: 40px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.2s;
    }
    .btn-home:hover {
        background: #d4a017;
        transform: scale(1.03);
    }
</style>