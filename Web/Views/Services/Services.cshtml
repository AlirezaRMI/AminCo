@{
    Layout = null;
    ViewData["Title"] = "Services | Amin Co";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/public/css/main.css">
    <link rel="stylesheet" href="~/public/css/setting.css">
    <style>
        .services-page {
            padding: 40px 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .services-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .services-page-title {
            text-align: right;
            color: #fff;
            font-size: 42px;
            font-weight: 700;
            margin: 0;
        }

        .services-page-subtitle {
            text-align: right;
            color: #aaa;
            font-size: 18px;
            margin-bottom: 50px;
            margin-top: -10px;
        }

        /* دکمه زبان */
        .lang-btn-wrapper {
            display: flex;
            justify-content: flex-end;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* کارت سرویس با رنگ‌های متناوب */
        .service-card {
            border-radius: 50px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 0;
            text-align: center;
            height: 100%;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        /* رنگ زرشکی (مثل small_baner_top) */
        .service-card.maroon {
            background: linear-gradient(180deg, #710D20 0%, #B54D60 100%);
        }

        /* رنگ استیلی/نقره‌ای (مثل small_baner_bottom) */
        .service-card.silver {
            background: linear-gradient(135deg, #cbcbcb 70%, #898989 100%);
        }

        /* بخش تصویر */
        .service-card .service-image {
            width: 100%;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 10px;
        }

        .service-card .service-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
            transition: transform 0.3s ease;
        }

        .service-card:hover .service-image img {
            transform: scale(1.05);
        }

        .service-card.silver .service-image img {
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.15));
        }

        /* بخش محتوا */
        .service-card .service-content {
            padding: 20px 25px 30px;
            width: 100%;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .service-card .service-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .service-card.maroon .service-title {
            color: #fff;
        }

        .service-card.silver .service-title {
            color: #1a1a1a;
        }

        .service-card .service-desc {
            font-size: 14px;
            line-height: 1.6;
            max-width: 280px;
            margin-bottom: 18px;
        }

        .service-card.maroon .service-desc {
            color: rgba(255,255,255,0.85);
        }

        .service-card.silver .service-desc {
            color: #333;
        }

        .service-card .service-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s;
            padding: 8px 20px;
            border-radius: 30px;
        }

        .service-card.maroon .service-link {
            color: #fff;
            background: rgba(255,255,255,0.15);
        }

        .service-card.maroon .service-link:hover {
            background: rgba(255,255,255,0.3);
        }

        .service-card.silver .service-link {
            color: #1a1a1a;
            background: rgba(0,0,0,0.08);
        }

        .service-card.silver .service-link:hover {
            background: rgba(0,0,0,0.18);
        }

        .service-card .service-link svg {
            width: 18px;
            height: 18px;
            transition: 0.3s;
        }

        .service-card .service-link:hover svg {
            transform: translateX(-4px);
        }

        /* ریسپانسیو */
        @@media (max-width: 1024px) {
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 25px;
            }
        }

        @@media (max-width: 640px) {
            .services-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .services-page-title {
                font-size: 28px;
            }

            .services-header {
                flex-direction: column;
                align-items: stretch;
            }

            .lang-btn-wrapper {
                justify-content: center;
            }

            .service-card .service-image {
                height: 160px;
            }

            .service-card .service-title {
                font-size: 18px;
            }
        }
    </style>
</head>
<body class="bg-[#171818] font-[Vazirmatn,sans-serif]">
<partial name="_Header" />
<div class="services-page">
    <div class="services-grid">
        <!-- کارت 1 - زرشکی -->
        <div class="service-card maroon">
            <div class="service-image">
                <img src="/public/img/header/item_img/1.png" alt="مشاوره">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_1_title">مشاوره حرفه‌ای</h3>
                <p class="service-desc" data-i18n="service_1_desc">بررسی نیازها و ارائه بهترین راهکار متناسب با فضای شما</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                    درخواست مشاوره
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- کارت 2 - استیلی -->
        <div class="service-card silver">
            <div class="service-image">
                <img src="/public/img/header/item_img/2.png" alt="طراحی">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_2_title">طراحی آشپزخانه</h3>
                <p class="service-desc" data-i18n="service_2_desc">طراحی سه‌بعدی و فنی با رعایت استانداردهای ایمنی</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                    درخواست طراحی
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- کارت 3 - زرشکی -->
        <div class="service-card maroon">
            <div class="service-image">
                <img src="/public/img/header/item_img/3.png" alt="تولید">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_3_title">تولید تجهیزات</h3>
                <p class="service-desc" data-i18n="service_3_desc">ساخت تجهیزات صنعتی با مرغوب‌ترین متریال و دقت بالا</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                   سفارش تولید
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- کارت 4 - استیلی -->
        <div class="service-card silver">
            <div class="service-image">
                <img src="/public/img/header/item_img/4.png" alt="تامین">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_4_title">تامین تجهیزات</h3>
                <p class="service-desc" data-i18n="service_4_desc">دسترسی به برندهای معتبر داخلی و خارجی</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                    تماس با ما
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- کارت 5 - زرشکی -->
        <div class="service-card maroon">
            <div class="service-image">
                <img src="/public/img/header/item_img/5.png" alt="نصب">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_5_title">آموزش</h3>
                <p class="service-desc" data-i18n="service_5_desc">آموزش اصولی مبانی صنعت توسط آکادمی مجرب</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                    مشاهده آموزش ها
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <!-- کارت 6 - استیلی -->
        <div class="service-card silver">
            <div class="service-image">
                <img src="/public/img/header/item_img/6.png" alt="پشتیبانی">
            </div>
            <div class="service-content">
                <h3 class="service-title" data-i18n="service_6_title">پشتیبانی</h3>
                <p class="service-desc" data-i18n="service_6_desc">خدمات پس از فروش، سرویس و تامین قطعات یدکی</p>
                <a href="/Home/Contact" class="service-link" data-i18n="service_link">
                    درخواست پشتیبانی
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>

<script src="~/public/i18next/dist/umd/i18next.js"></script>
<script src="~/public/js/language.js"></script>
<script src="~/public/js/languagebtn.js"></script>
<script src="~/public/js/count.js"></script>
<script src="~/public/js/animate.js"></script>
<script src="~/public/js/menu.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof setLanguage === 'function') {
            setLanguage('en');
        }
    });
</script>
</body>
</html>