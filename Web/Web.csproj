<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Application\Application.csproj" />
        <ProjectReference Include="..\Data\Data.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Csp" Version="1.0.0" />
        <PackageReference Include="EPPlus" Version="8.5.4" />
        <PackageReference Include="Magn.AspNetCore.RateLimiting" Version="0.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.9" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
        <PackageReference Include="FluentValidation" Version="12.0.0" />
        <PackageReference Include="Microsoft.OpenApi" Version="1.6.23" />
        <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
        <PackageReference Include="NWebsec.AspNetCore.Middleware" Version="3.0.0" />
        <PackageReference Include="OpenTelemetry" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
        <PackageReference Include="Rotativa.AspNetCore" Version="1.4.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.12.41" />
        <PackageReference Include="Scaler" Version="1.0.2.7" />
        <PackageReference Include="SharpAbp.Abp.OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="4.6.7" />
    </ItemGroup>
    
    

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Include="wwwroot\public\i18next\.claude\settings.local.json" />
    </ItemGroup>
    
    

    <ItemGroup>
      <Folder Include="Areas\Admin\ViewModels\" />
    </ItemGroup>
    
    

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\css\site.css" />
    </ItemGroup>
    
    

    <ItemGroup>
      <TypeScriptCompile Include="wwwroot\public\i18next\index.d.ts" />
      <TypeScriptCompile Include="wwwroot\public\i18next\typescript\helpers.d.ts" />
      <TypeScriptCompile Include="wwwroot\public\i18next\typescript\options.d.ts" />
      <TypeScriptCompile Include="wwwroot\public\i18next\typescript\t.d.ts" />
    </ItemGroup>

</Project>
